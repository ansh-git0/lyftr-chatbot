# ---- Backend ----
# Comma-separated key pool (at least 2). Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-first-gemini-key,your-second-gemini-key
# LiteLLM model name used by every key
LLM_MODEL=gemini/gemini-3.5-flash-lite
# Optional: per-key model override, same order as LLM_API_KEYS (blank = LLM_MODEL)
LLM_KEY_MODELS=
# SQLite file on the /data Docker volume
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins (add your deployed frontend URL)
ALLOWED_ORIGINS=http://localhost:3000
# true enables the X-Simulate-Failure test header
ENABLE_FAILURE_SIMULATION=true
# LiteLLM cache: disk (survives restarts, stored next to the DB) or local (in-memory)
LLM_CACHE_TYPE=disk
LLM_CACHE_DIR=
LLM_CACHE_TTL_SECONDS=86400
# Optional tuning
DEFAULT_SYSTEM_PROMPT=
LLM_TIMEOUT_SECONDS=15
LLM_MAX_OUTPUT_TOKENS=2048
KEY_COOLDOWN_SECONDS=60
MAX_HISTORY_MESSAGES=40
LOG_LEVEL=INFO
# Local Windows dev behind TLS-inspecting antivirus/proxy: trust the OS cert store
USE_SYSTEM_CERTS=false

# ---- Frontend ----
# Backend URL the browser calls
VITE_API_BASE_URL=http://localhost:8000
